{
  "name": "algions-cinema-hall-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Cinema Hall Ticket Booking System - Algions AI Labs Full-Stack Assessment",
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "concurrently": "^9.2.5",
    "gremlins.js": "^2.2.0",
    "playwright": "^1.65.0"
  },
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "concurrently -n \"API,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --workspace=server test",
    "test:client": "npm --workspace=client test",
    "test": "npm run test:server",
    "lint:server": "npm --workspace=server run lint",
    "lint:client": "npm --workspace=client run lint",
    "lint": "npm run lint:server && npm run lint:client",
    "seed": "npm --workspace=server run seed"
  },
  "keywords": [
    "cinema-booking",
    "mongodb-transactions",
    "concurrency",
    "idempotency",
    "express",
    "react",
    "typescript"
  ],
  "author": "Algions Assessment Candidate",
  "license": "ISC"
}
