# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Connection (Replica Set required for transactions; Atlas M0 provides this)
# Append database name e.g. /cinema_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hzj9lns.mongodb.net/cinema_db?retryWrites=true&w=majority
# Fallback support for lowercase env key
# mongo_db_uri=mongodb+srv://<username>:<password>@cluster0.hzj9lns.mongodb.net/cinema_db?retryWrites=true&w=majority

# Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d
COOKIE_SECRET=super_secret_cookie_parser_secret_value

# Frontend Client URL (for CORS allow-list & Cookies)
CLIENT_URL=http://localhost:5173

# Security & HMAC
QR_HMAC_SECRET=super_secret_qr_token_signing_secret_key

# Business Rules
HOLD_MINUTES=5
MAX_SEATS_PER_BOOKING=8
CANCELLATION_CUTOFF_MINUTES=60
REFUND_PERCENTAGE=100
HOLD_SWEEPER_INTERVAL_MS=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

